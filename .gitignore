tmp/
temp/
*.tmp

# ─── Ölçüm çıktıları ────────────────────────────────────────────────
# benchmarks/ klasörü depoya girer; ham ve büyük ara dosyalar girmez.
benchmarks/**/*.raw
benchmarks/**/*.pkl
backend/src/sentinel/api/static/app/
*.tsbuildinfo
benchmarks/traces/

# E2E test kullanıcısının parolası (P-71)
frontend/.env.e2e

# Playwright çıktı klasörleri
frontend/test-results/
frontend/playwright-report/

# ─── Özel belgeler ──────────────────────────────────────────────────
# Depoya yalnızca kod ve kodun bulgularını içeren belgeler giriyor.
# Teslim edilecek raporlar, kurum şablonları, kişisel formlar ve sunum
# notları girmiyor.

# Dergi makalesi (taslaklar, .docx çıktıları, şablon, telif formu)
docs/report/makale/
# Staj raporu (metin, .docx çıktıları, AN02 anketi)
docs/report/staj/
# Staj raporu kurum şablonu
docs/report/Staj raporu.docx
docs/report/assets/
# Sunum notları
docs/report/sunum-notlari*.md
# Yazım dili örneği olarak koyduğum başka bir projenin raporu
docs/README.md
# Makale ve staj raporunu .docx'e çeviren betikler (kişisel bilgi içeriyor)
backend/scripts/makale_docx.py
backend/scripts/makale_sablon.py
backend/scripts/staj_raporu_docx.py
backend/scripts/staj_raporu_dogrula.py

# Şekillerin 600 dpi TIFF kopyaları: dergi gönderimi için üretiliyor,
# scripts/sekiller_elsevier.py ile yeniden üretilebilir.
docs/report/diagrams/elsevier/**/*.tiff
