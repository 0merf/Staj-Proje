# ─── Yerel çalışma notları ──────────────────────────────────────────
# Plan ve çalışma notlarımı yerelde tutuyorum, depoya koymuyorum.
PLAN.md
CLAUDE.md
LITERATUR.md
CALISMA.md
YOL-HARITASI.md

# ─── Sırlar ─────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
**/credentials*.json

# ─── Veri ve modeller ───────────────────────────────────────────────
# İçerik depoya girmiyor, klasör yapısı .gitkeep ile korunuyor.
data/videos/*
data/datasets/*
data/clips/*
# Yer gerçeği dosyaları istisna: *.gorsel.json ve *.truth.json dosyaları
# birkaç KB, görüntü içermiyor ve K8 ölçümlerinin tanımı bunlarda. Bunlar
# olmadan benchmarks/k8_video_*.json yeniden üretilemez (P-50).
data/annotations/*
!data/annotations/*.gorsel.json
!data/annotations/*.truth.json
# MediaMTX sürekli kaydı. Gerçek görüntü içeriyor (webcam dahil).
data/recordings/*

# Kamera normal profilleri (Katman A). Makineye özel, çalışırken sürekli
# değişiyor. Depoya girmiyor ama yedeklenmesi gerekiyor: profil kaybolursa
# anomali katmanı yeniden ısınana kadar kör kalıyor.
data/profiles/*
# Ham veri setleri: boyut ve lisans nedeniyle depoya girmiyor.
# Kaynak ve lisans bilgisi SOURCE.md dosyalarında.
data/_sources/*
data/archive/*
# UBI-Fights: etiket CSV'leri de dahil hiçbiri girmiyor. Veri seti
# akademik kullanım şartıyla dağıtılıyor, yeniden dağıtım hakkım yok.
data/UBI_FIGHTS/*
!data/UBI_FIGHTS/SOURCE.md
data/fall-01-cam0-rgb/*
!data/fall-01-cam0-rgb/SOURCE.md
# ffmpeg concat listeleri gibi geçici dosyalar
data/_tmp/*
models/*
# Model künyeleri istisna: hangi kare hızıyla, hangi özellik dosyasıyla,
# kaç klip ile eğitildiği yazıyor (P-63). Birkaç KB.
!models/*.kunye.json
# Tüm betikler <kök>/models/ okuyor; backend/models/ eski konumdu (P-63).
backend/models/*
# İstisna: kendi eğittiğim saldırganlık modeli (138 KB). K5/K8 sayıları
# bu modelden geliyor, depoda olmazsa yeniden üretilemez.
!models/saldirganlik_lgbm.txt
!**/.gitkeep

# SOURCE.md dosyaları depoya girer: her veri setinin indirme adresi,
# lisansı ve alıntı bilgisi. Önce alt klasörleri geri alıp içeriklerini
# eliyorum, en son SOURCE.md'yi geri ekliyorum (sıra önemli).
!data/datasets/*/
data/datasets/*/*
!data/_sources/*/
data/_sources/*/*
!**/SOURCE.md
# Ağırlıkların SHA256 kaydı (bütünlük doğrulaması, G26)
!models/checksums.json
*.pt
*.onnx
*.engine
*.trt
*.pth
*.safetensors
*.mp4
*.avi
*.mkv
*.mov

