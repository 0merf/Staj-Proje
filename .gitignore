# ─── VERİ VE MODELLER (büyük dosyalar) ──────────────────────
# İçerik yok sayılır ama dizin yapısı .gitkeep ile korunur
data/videos/*
data/datasets/*
data/clips/*
# ⚠⚠ 07.09.2026 — YER GERÇEĞİ DOSYALARI İSTİSNA (P-50/P-51)
#
# Bu dizin baştan tamamen eleniyordu. Ama içindeki `*.gorsel.json` ve
# `*.truth.json` dosyaları BÜYÜK VERİ DEĞİL, ÖLÇÜMÜN TANIMI:
# hangi saniyede olayın başladığını, hangi aralığın doğrulanmış
# normal olduğunu, hangi aralığın ölçüm dışı bırakıldığını yazıyorlar.
#
# ⭐ K8'in tüm sayıları bu dosyalara bağlı. Onlar olmadan
# `benchmarks/k8_video_*.json` yeniden üretilemez — ve P-50 tam da
# yer gerçeğinin tanımının sonucu değiştirdiğini gösteren kayıt.
# Ölçümü saklayıp tanımını atmak, ölçümü saklamamaktır.
#
# Birkaç KB; görüntü içermiyorlar.
data/annotations/*
!data/annotations/*.gorsel.json
!data/annotations/*.truth.json
# MediaMTX sürekli kaydı — olay klibinin kaynağı (~4.5 GB/saat).
# ⚠ Bunlar gerçek görüntü içerir (webcam dahil); asla commit edilmez.
data/recordings/*

# KATMAN A'nın öğrendiği kamera normal profilleri (analytics/anomaly/normalcy.py).
# Git'e GİRMEZ: makineye ve o makinedeki kamera çiftliğine özel, çalışırken
# yeniden üretiliyor ve sürekli değişiyor — her koşuda diff üretirdi.
# ⚠ Ama YEDEKLENMESİ gereken bir şey: profil kaybı sistemin saatlerce
# kör kalması demek. Üretimde yedekleme politikasına dâhil edilmeli.
data/profiles/*
# ham indirilen veri setleri (VIRAT, Oxford, PETS…)
data/_sources/*
# Ham veri setleri — git'e ASLA girmez (boyut + lisans).
# Kaynak/lisans bilgisi data/SOURCE.md dosyalarinda tutulur.
data/archive/*
# UBI-Fights (socia-lab.di.ubi.pt/EventDetection) — 1000 video, 7.8 GB.
# Videolar zaten `*.mp4` ile eleniyor; ama `annotation/` altındaki 1000
# CSV elenmiyordu ve commit'e girecekti. Üçüncü taraf etiketleri git'e
# GİRMEZ (boyut değil, LİSANS): veri seti akademik kullanım şartıyla
# dağıtılıyor, yeniden dağıtım hakkı bizde değil.
data/UBI_FIGHTS/*
!data/UBI_FIGHTS/SOURCE.md
data/fall-01-cam0-rgb/*
!data/fall-01-cam0-rgb/SOURCE.md
# ffmpeg concat listeleri gibi geçici dosyalar
data/_tmp/*
models/*
# ⚠ 09.09.2026 — MODEL KÜNYELERİ İSTİSNA (P-63)
#
# Ağırlık dosyaları git'e girmez (büyük, yeniden üretilebilir) ama
# KÜNYELER girer: hangi kare hızıyla, hangi özellik dosyasıyla, kaç
# klip ile eğitildiği. Birkaç KB.
#
# Neden: bir FPS taraması üretim modelinin üzerine beş kez yazdı ve
# üretimde 24.75 FPS'te eğitilmiş bir model bir gün boyunca oturdu.
# Kimse fark etmedi çünkü model dosyası KENDİSİNİN NE OLDUĞUNU
# söylemiyordu. Künyeyi yoksaymak, tam da düzeltmeye çalıştığımız
# körlüğü geri getirirdi.
!models/*.kunye.json
# ⚠⚠ 08.09.2026 — İKİ MODEL DİZİNİ VARDI VE BU SESSİZ BİR HATAYDI.
#
# Üretim `config.py · resolve_path()` ile `<kök>/models/` okuyor;
# ölçüm betikleri ise `backend/models/` yazıyordu. Eğitilen model
# üretimin BAKMADIĞI yere kaydediliyordu — `SaldirganlikModeli`
# "model yok" deyip sessizce devre dışı kalıyordu.
#
# ⚠ Ayrıca YOLO ağırlıkları İKİ YERDE birden duruyordu (~100 MB kopya).
# 16 betik `<kök>/models/` okuyacak şekilde düzeltildi.
backend/models/*
# ⭐ İSTİSNA: eğittiğimiz saldırganlık modeli (138 KB). Üçüncü taraf
# ağırlık değil, BİZİM çıktımız ve K5/K8 sayılarının kaynağı.
# Git'e girmezse makalenin hiçbir sayısı yeniden üretilemez.
!models/saldirganlik_lgbm.txt
!**/.gitkeep

# ⚠ SOURCE.md dosyalari git'e GİRER — PLAN.md §7.2:
#   "Her veri seti için indirme adresi, lisans ve alıntı bilgisi."
# Veri girmez, KAYNAĞIN BELGESİ girer. Bu dosyalar olmadan hangi verinin
# nereden geldiği ve hangi lisansla kullanıldığı kayboluyor — rapor ve
# tekrarlanabilirlik açısından veri kadar değerliler.
#
# Not: `data/datasets/*` alt DİZİNLERİ de elediği için git içlerine
# hiç bakmıyordu. Önce dizinleri geri alıyoruz, sonra içeriklerini
# eliyoruz, en son SOURCE.md'yi kurtarıyoruz — sıra önemli.
!data/datasets/*/
data/datasets/*/*
!data/_sources/*/
data/_sources/*/*
!**/SOURCE.md
# Ağırlıkların SHA256 kaydı git'te DURMALI — tekrarlanabilirlik ve
# bütünlük doğrulaması için (G26). Dosyaların kendisi değil, sadece kayıt.
!models/checksums.json
*.pt
*.onnx
*.engine
*.trt
*.pth
*.safetensors
*.mp4
*.avi
*.mkv
*.mov

