# ══════════════════════════════════════════════════════════════
#  SENTINEL — Ortam Değişkenleri ŞABLONU
#  Kullanım:  cp .env.example .env   (sonra gerçek değerleri gir)
#  ⚠ .env dosyası ASLA commit edilmez — .gitignore'da
# ══════════════════════════════════════════════════════════════

# ─── GENEL ────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8001
SENTINEL_ENV=development          # development | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
TZ=Europe/Istanbul

# ─── POSTGRESQL + TIMESCALEDB ─────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=sentinel
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://sentinel:CHANGE_ME_strong_password_here@127.0.0.1:5433/sentinel

# ─── VALKEY (Redis protokol uyumlu) ──────────────────────────
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_PASSWORD=CHANGE_ME_valkey_password
VALKEY_URL=redis://:CHANGE_ME_valkey_password@127.0.0.1:6379/0

# Stream isimleri ve sınırları (geri basınç için kritik)
STREAM_FRAMES=frames.ready
STREAM_RESULTS=inference.results
STREAM_FRAMES_MAXLEN=64
STREAM_RESULTS_MAXLEN=5000

# ─── GARAGE (S3 uyumlu nesne deposu) ─────────────────────────
# ⛔ KODDA OKUNMUYOR — Garage/S3 KULLANILMIYOR — klipler yerel diske yaziliyor (data/clips)
# ⛔ S3_ENDPOINT=http://127.0.0.1:3900
# ⛔ S3_REGION=garage
# ⛔ S3_ACCESS_KEY=CHANGE_ME_access_key
# ⛔ S3_SECRET_KEY=CHANGE_ME_secret_key
# ⛔ S3_BUCKET_CLIPS=sentinel-clips
STORAGE_BACKEND=garage            # garage | localfs

# ─── MEDIAMTX ─────────────────────────────────────────────────
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_PORT=9997

# ⚠ SÜREKLİ KAYIT — varsayılan KAPALI (no)
# Olay klibinin kaynağı. Kaynak videolar SONSUZ DÖNGÜDE yayınlandığı
# için kayıt açıkken disk durmadan yazılır: ölçülen hız ~14 GB/saat
# (20 kamera). Klip/alarm zinciri üzerinde çalışılmayan günlerde bu
# tamamen israf — Gün 19'a kadar kimse klip kesmiyor.
#
# Açmak için:  MEDIAMTX_RECORD=yes  +  docker compose up -d mediamtx
#
# Üç katmanlı disk koruması:
#   1. varsayılan kapalı (bu değişken)
#   2. çalışırken 1 saatte döner (mediamtx.yml · recordDeleteAfter)
#   3. kapanışta silinir (backend/scripts/stop_all.ps1)
MEDIAMTX_RECORD=no

# ─── GÜVENLİK ─────────────────────────────────────────────────
# Üretmek için:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Klip URL imzalama (HMAC)
# ⛔ KODDA OKUNMUYOR — IMZALI KLIP URL'LERI (G21) UYGULANMADI — klip ucu JWT + beyaz liste ile korunuyor
# ⛔ CLIP_URL_SECRET=CHANGE_ME_another_random_secret
# ⛔ CLIP_URL_EXPIRE_SECONDS=300

# CORS ve WebSocket Origin beyaz listesi (virgülle ayrılmış)
# ⚠ WebSocket CORS'a uymaz — Origin ELLE doğrulanır
# Gelistirme sunucusu HER IKI yazimla da whitelist'te olmali:
# tarayici adres cubuguna ne yazildiysa Origin o gider ve
# 127.0.0.1 ile localhost AYRI kokenlerdir (bkz. problems.md P-11).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Hız sınırlama
RATE_LIMIT_LOGIN_PER_MINUTE=5
# ⛔ KODDA OKUNMUYOR — GENEL API hiz siniri UYGULANMADI — yalnizca GIRIS sinirli (RATE_LIMIT_LOGIN_PER_MINUTE)
# ⛔ RATE_LIMIT_API_PER_MINUTE=120
MAX_WS_CONNECTIONS_PER_USER=4

# İlk admin kullanıcı (yalnızca ilk kurulumda)
# ⛔ KODDA OKUNMUYOR — OTOMATIK ADMIN OLUSTURMA UYGULANMADI — scripts/kullanici_ekle.py kullaniliyor
# ⛔ BOOTSTRAP_ADMIN_USERNAME=admin
# ⛔ BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ─── BORU HATTI AYARLARI ─────────────────────────────────────
CAMERA_COUNT=20
TARGET_FPS=4                      # kamera başına analiz FPS'i
TARGET_FPS_HIGH_RISK=8            # risk > 0.4 iken
TARGET_FPS_IDLE=1                 # 30 sn hareketsizlik sonrası
INGEST_WORKER_COUNT=4
# ⛔ KODDA OKUNMUYOR — KAMERA BOLUSTURME uretimde KULLANILMIYOR — tek worker + 96 slot daha iyi cikti (P-69)
# ⛔ CAMERAS_PER_WORKER=5
RING_BUFFER_SECONDS=30            # olay öncesi kayıt tamponu
# ⭐⭐ P-69: 48 -> 96. Kod varsayılanı 128'di; bu dosya sessizce üçte
# bire düşürüyordu ve gerekçesi yazılı değildi. Havuz tükeniyordu.
# Ölçüldü: 48 -> 96 slot ile verim +%23, gecikme p50 −%59, p95 −%62.
# Maliyet 133 -> 265 MB (slot = 1280×720×3 bayt).
SHM_SLOT_COUNT=96

# Kademe 0 — hareket filtresi
MOTION_GATE_ENABLED=true
MOTION_THRESHOLD=0.005            # ön plan piksel oranı
MOTION_REFRESH_INTERVAL_S=5       # zorunlu tam analiz aralığı

# ─── MODELLER ─────────────────────────────────────────────────
DETECTOR_BACKEND=yolo26           # yolo26 | yolo11 | rtmdet
DETECTOR_MODEL_PATH=models/yolo26s.pt
DETECTOR_CONF_THRESHOLD=0.35
POSE_MODEL_PATH=models/yolo26s-pose.pt
# KADEME 2a - poz tahmini. Kapatmak kare basina ~9 ms kazandirir ama
# saldirganlik modulunun girdisini yok eder (PLAN.md 6.5).
POSE_ENABLED=true
POSE_CROP_SIZE=192               # 256 iskelet basarisini %88->%91 cikarir, %12 pahali
POSE_CROP_BATCH=64               # tipik yuk tek GPU cagrisina sigsin (32'de ikiye bolunuyordu)
POSE_CONF_THRESHOLD=0.25
FACE_DETECTOR_PATH=models/yunet.onnx
EMOTION_MODEL_PATH=models/emotieff.onnx
TRACKER=botsort                   # botsort | bytetrack | boosttrack

# ══════════════════════════════════════════════════════════════
# ⚠ 03.09.2026 — 16 AYAR BURADAN KALDIRILDI: HİÇBİRİ OKUNMUYORDU
# ══════════════════════════════════════════════════════════════
#
# Kaldırılanlar: USE_TENSORRT · USE_FP16 · PRIVACY_BLUR_DEFAULT ·
# WEIGHT_* (5) · THRESHOLD_* (6) · ALERT_COOLDOWN_SECONDS ·
# ALERT_TRACK_COOLDOWN_SECONDS · RETENTION_* (3)
#
# Hiçbiri `config.py`'de tanımlı değildi, yani hiçbiri koda
# ulaşmıyordu. Bu dosya bir "planlanan yapılandırma" belgesine
# dönüşmüştü ve DEPOYA GİRİYORDU — projeyi okuyan biri buradaki
# değerleri sistemin gerçek ayarları sanardı.
#
# ⚠ İkisi doğrudan YANLIŞ bilgi veriyordu:
#
#   THRESHOLD_ALARM_IN=0.75   ← gerçek eşik 0.55
#                               (analytics/fusion.py · ESIK_ALARM_GIR)
#   RETENTION_EVENTS_DAYS=90  ← gerçek saklama 30 gün
#                               (db/schema.py · SAKLAMA_GUN)
#
# Yani yalnızca ölü değil, aktif olarak yanıltıcıydılar. Bir
# yapılandırma dosyası okuyucuya sistemin davranışını anlatır;
# yanlış anlatıyorsa belge değil tuzaktır.
#
# ⚠ GERÇEK DEĞERLER NEREDE (kod tek doğru kaynak):
#   füzyon ağırlıkları + eşikler → analytics/fusion.py (üst blok)
#   alarm soğuma süreleri        → analytics/anomaly/rules.py
#                                  (SOGUMA_KAMERA_S / SOGUMA_IZ_S /
#                                   SOGUMA_OLAGANDISI_S)
#   olay saklama süresi          → db/schema.py · SAKLAMA_GUN
#   TensorRT durumu              → docs/decisions/0006-tensorrt.md
#                                  (ÖLÇÜLDÜ ama üretimde DEĞİL)
#   FP16                         → dedektör kurulumunda half=True
#
# Bu değerlerin yapılandırılabilir olması PLAN §6.6'nın hedefiydi
# ("ağırlıklar konfigürasyondan ayarlanabilir") ve yapılmadı.
# Açık iş olarak duruyor — ama "yapılmış gibi görünen" bir açık iş
# olarak değil.

# ─── KVKK / MAHREMİYET ───────────────────────────────────────
# ⚠ Yüz bulanıklaştırma (PRIVACY_BLUR_DEFAULT) bu staj kapsamının
# DIŞINDA bırakıldı ve ayarı kaldırıldı. Kodlanmamış bir özelliğin
# ayarını "true" bırakmak, yapılmamış bir işi yapılmış göstermekti.
STORE_FACE_CROPS=false            # ⚠ ASLA true yapma (biyometrik veri)
                                  # Bu ayar OKUNUYOR: true yapılırsa
                                  # uygulama açılışta hata verip durur
                                  # (config.py · _forbid_face_storage)

# ─── GÖZLEMLENEBİLİRLİK ──────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
METRICS_ENABLED=true
