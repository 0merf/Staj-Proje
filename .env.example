# ══════════════════════════════════════════════════════════════
#  SENTINEL — Ortam Değişkenleri ŞABLONU
#  Kullanım:  cp .env.example .env   (sonra gerçek değerleri gir)
#  ⚠ .env dosyası ASLA commit edilmez — .gitignore'da
# ══════════════════════════════════════════════════════════════

# ─── GENEL ────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8001
SENTINEL_ENV=development          # development | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
TZ=Europe/Istanbul

# ─── POSTGRESQL + TIMESCALEDB ─────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=sentinel
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://sentinel:CHANGE_ME_strong_password_here@127.0.0.1:5433/sentinel

# ─── VALKEY (Redis protokol uyumlu) ──────────────────────────
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_PASSWORD=CHANGE_ME_valkey_password
VALKEY_URL=redis://:CHANGE_ME_valkey_password@127.0.0.1:6379/0

# Stream isimleri ve sınırları (geri basınç için kritik)
STREAM_FRAMES=frames.ready
STREAM_RESULTS=inference.results
STREAM_FRAMES_MAXLEN=200
STREAM_RESULTS_MAXLEN=5000

# ─── GARAGE (S3 uyumlu nesne deposu) ─────────────────────────
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_ACCESS_KEY=CHANGE_ME_access_key
S3_SECRET_KEY=CHANGE_ME_secret_key
S3_BUCKET_CLIPS=sentinel-clips
STORAGE_BACKEND=garage            # garage | localfs

# ─── MEDIAMTX ─────────────────────────────────────────────────
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_PORT=9997

# ─── GÜVENLİK ─────────────────────────────────────────────────
# Üretmek için:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Klip URL imzalama (HMAC)
CLIP_URL_SECRET=CHANGE_ME_another_random_secret
CLIP_URL_EXPIRE_SECONDS=300

# CORS ve WebSocket Origin beyaz listesi (virgülle ayrılmış)
# ⚠ WebSocket CORS'a uymaz — Origin ELLE doğrulanır
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Hız sınırlama
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=120
MAX_WS_CONNECTIONS_PER_USER=4

# İlk admin kullanıcı (yalnızca ilk kurulumda)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ─── BORU HATTI AYARLARI ─────────────────────────────────────
CAMERA_COUNT=20
TARGET_FPS=4                      # kamera başına analiz FPS'i
TARGET_FPS_HIGH_RISK=8            # risk > 0.4 iken
TARGET_FPS_IDLE=1                 # 30 sn hareketsizlik sonrası
INGEST_WORKER_COUNT=4
CAMERAS_PER_WORKER=5
RING_BUFFER_SECONDS=30            # olay öncesi kayıt tamponu
SHM_SLOT_COUNT=128

# Kademe 0 — hareket filtresi
MOTION_GATE_ENABLED=true
MOTION_THRESHOLD=0.005            # ön plan piksel oranı
MOTION_REFRESH_INTERVAL_S=5       # zorunlu tam analiz aralığı

# ─── MODELLER ─────────────────────────────────────────────────
DETECTOR_BACKEND=yolo26           # yolo26 | yolo11 | rtmdet
DETECTOR_MODEL_PATH=models/yolo26s.pt
DETECTOR_CONF_THRESHOLD=0.35
POSE_MODEL_PATH=models/yolo26s-pose.pt
FACE_DETECTOR_PATH=models/yunet.onnx
EMOTION_MODEL_PATH=models/emotieff.onnx
TRACKER=botsort                   # botsort | bytetrack | boosttrack
USE_TENSORRT=true
USE_FP16=true

# ─── RİSK FÜZYONU (PLAN.md §6.6) ─────────────────────────────
WEIGHT_AGGRESSION=0.40
WEIGHT_ANOMALY=0.25
WEIGHT_RULES=0.20
WEIGHT_EXPRESSION=0.10
WEIGHT_CROWD=0.05

# Histerezis eşikleri: girme / çıkma
THRESHOLD_ATTENTION_IN=0.35
THRESHOLD_ATTENTION_OUT=0.25
THRESHOLD_WARNING_IN=0.55
THRESHOLD_WARNING_OUT=0.40
THRESHOLD_ALARM_IN=0.75
THRESHOLD_ALARM_OUT=0.55

# Alarm bastırma
ALERT_COOLDOWN_SECONDS=60
ALERT_TRACK_COOLDOWN_SECONDS=120

# ─── KVKK / MAHREMİYET ───────────────────────────────────────
PRIVACY_BLUR_DEFAULT=true         # yüzler varsayılan bulanık
RETENTION_CLIPS_DAYS=30
RETENTION_EVENTS_DAYS=90
RETENTION_METRICS_DAYS=30
STORE_FACE_CROPS=false            # ⚠ ASLA true yapma (biyometrik veri)

# ─── GÖZLEMLENEBİLİRLİK ──────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
METRICS_ENABLED=true
